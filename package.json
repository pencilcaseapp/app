{
  "name": "app",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "cross-env NODE_ENV=production node ./server.js",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "dev": "cross-env ENV=development tsx ./server.ts",
    "build": "run-p \"build:*\"",
    "build:react-router": "react-router build",
    "build:server": "esbuild ./server.ts --outdir=./ --bundle --format=esm --platform=node --target=node24 --packages=external --external:./build/server/index.js",
    "test": "vitest",
    "typecheck": "react-router typegen && tsc",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "lint": "eslint ."
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@fontsource/inter": "^5.3.0",
    "@hocuspocus/extension-database": "^4.5.0",
    "@hocuspocus/provider": "^4.5.0",
    "@hocuspocus/server": "^4.0.0",
    "@lexical/code-prism": "^0.49.0",
    "@lexical/headless": "^0.49.0",
    "@lexical/react": "^0.49.0",
    "@lexical/yjs": "^0.49.0",
    "@oslojs/crypto": "^1.0.1",
    "@oslojs/encoding": "^1.1.0",
    "@radix-ui/react-accordion": "^1.2.20",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-separator": "^1.1.15",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@react-router/express": "^8.3.0",
    "@react-router/node": "8.3.0",
    "@tanstack/react-form": "^1.33.3",
    "@tanstack/react-form-remix": "^1.33.3",
    "@uidotdev/usehooks": "^2.4.1",
    "argon2": "^0.45.1",
    "body-scroll-lock": "^4.0.0-beta.0",
    "classnames": "^2.5.1",
    "compression": "^1.8.1",
    "cross-env": "^10.1.0",
    "crossws": "^0.4.10",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^1.0.0-rc.5-169397b",
    "env-var": "^7.5.0",
    "express": "^5.2.1",
    "input-otp": "^1.4.2",
    "internal-ip": "^9.0.0",
    "isbot": "^5.2.1",
    "lettermint": "^2.1.0",
    "lexical": "^0.49.0",
    "motion": "^13.0.0",
    "pg": "^8.22.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router": "8.3.0",
    "react-use": "^17.6.1",
    "remix-utils": "^10.0.0",
    "uuid": "^14.0.1",
    "yjs": "^13.6.32",
    "zod": "^4.4.3"
