{
  "name": "app",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "cross-env NODE_ENV=production node ./server.js",
    "docker:up": "docker compose up -d --wait",
    "docker:down": "docker compose down",
    "dev": "cross-env ENV=development tsx ./server.ts",
    "build": "run-p \"build:*\"",
    "build:react-router": "react-router build",
    "build:server": "esbuild ./server.ts --outdir=./ --bundle --format=esm --platform=node --target=node24 --packages=external --external:./build/server/index.js",
    "test": "vitest",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "email": "email dev --dir app/emails/templates --port 3001",
    "typecheck": "react-router typegen && tsc",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "lint": "eslint ."
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1163.0",
    "@base-ui/react": "^1.9.0",
    "@bull-board/api": "^9.11.0",
    "@bull-board/express": "^9.11.0",
    "@capacitor/android": "^8.6.0",
    "@capacitor/core": "^8.5.3",
    "@capacitor/ios": "^8.6.0",
    "@capacitor/splash-screen": "^8.0.2",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/source-serif-4": "^5.3.1",
    "@hocuspocus/extension-database": "^4.8.0",
    "@hocuspocus/extension-redis": "^4.8.0",
    "@hocuspocus/provider": "^4.8.0",
    "@hocuspocus/server": "^4.0.0",
    "@lexical/code-prism": "^0.53.0",
    "@lexical/headless": "^0.53.0",
    "@lexical/react": "^0.53.0",
    "@lexical/utils": "^0.53.0",
    "@lexical/yjs": "^0.53.0",
    "@oslojs/crypto": "^1.0.1",
    "@oslojs/encoding": "^1.1.0",
    "@radix-ui/react-accordion": "^1.3.1",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-separator": "^1.2.0",
    "@radix-ui/react-tooltip": "^1.4.1",
    "@react-router/express": "^8.5.1",
    "@react-router/node": "8.5.1",
    "@tanstack/react-form": "^1.33.3",
    "@tanstack/react-form-remix": "^1.33.3",
    "@uidotdev/usehooks": "^2.4.1",
    "argon2": "^0.45.2",
    "bullmq": "^6.7.1",
    "classnames": "^2.5.1",
    "compression": "^1.8.2",
    "creem": "^1.13.0",
    "cross-env": "^10.1.0",
    "crossws": "^0.4.17",
    "dotenv": "^18.0.9",
    "drizzle-orm": "^1.0.0-rc.5",
    "env-var": "^7.5.0",
    "express": "^5.3.0",
    "input-otp": "^1.5.0",
    "internal-ip": "^9.0.0",
    "isbot": "^5.2.2",
    "lettermint": "^3.3.0",
    "lexical": "^0.53.0",
    "motion": "^14.10.1",
    "pg": "^8.23.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-email": "^6.11.7",
    "react-router": "8.5.1",
