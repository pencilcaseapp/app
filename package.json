    "eslint": "^10.8.0",
    "happy-dom": "^20.11.1",
    "npm-run-all2": "^9.0.3",
    "storybook": "^10.3.5",
    "tailwind-scrollbar": "^4.0.2",
    "tailwindcss": "^4.2.2",
    "tsx": "^4.23.11",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.66.0",
    "vite": "^8.2.1",
    "vite-plugin-devtools-json": "^1.1.0",
    "vitest": "^4.1.10"
