{
  "name": "app",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "cross-env NODE_ENV=production node ./server.js",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "dev": "tsx ./server.ts",
    "build": "run-p \"build:*\"",
    "build:react-router": "react-router build",
    "build:server": "esbuild ./server.ts --outdir=./ --bundle --format=esm --platform=node --target=node24 --packages=external --external:./build/server/index.js",
    "test": "cross-env ENV=test vitest",
    "typecheck": "react-router typegen && tsc",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "lint": "eslint ."
  },
  "dependencies": {
    "@fontsource/inter": "^5.2.8",
    "@hocuspocus/extension-database": "^3.4.4",
    "@hocuspocus/provider": "^3.4.4",
    "@hocuspocus/server": "^3.4.4",
    "@lexical/headless": "^0.43.0",
    "@lexical/react": "^0.43.0",
    "@lexical/yjs": "^0.43.0",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@react-router/express": "^7.14.0",
    "@react-router/node": "7.14.0",
    "@uidotdev/usehooks": "^2.4.1",
    "body-scroll-lock": "^4.0.0-beta.0",
    "classnames": "^2.5.1",
    "compression": "^1.8.1",
    "cross-env": "^10.1.0",
    "drizzle-orm": "^1.0.0-beta.22-41a7d21",
    "drizzle-seed": "^1.0.0-beta.22-41a7d21",
    "env-var": "^7.5.0",
    "express": "^5.2.1",
    "express-ws": "^5.0.2",
    "internal-ip": "^9.0.0",
    "isbot": "^5.1.38",
    "lexical": "^0.43.0",
    "pg": "^8.20.0",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "react-router": "7.14.0",
    "react-use": "^17.6.0",
    "uuid": "^13.0.0",
    "yjs": "^13.6.30"
  },
  "devDependencies": {
    "@eslint-react/eslint-plugin": "^4.2.3",
    "@faker-js/faker": "^10.4.0",
    "@react-router/dev": "^7.14.0",
    "@storybook/addon-docs": "^10.3.5",
    "@storybook/react-vite": "^10.3.5",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@tailwindcss/vite": "^4.2.2",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/body-scroll-lock": "^3.1.2",
    "@types/compression": "^1.8.1",
    "@types/express": "^5.0.6",
    "@types/express-ws": "^3.0.6",
    "@types/node": "^25",
    "@types/pg": "^8.20.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "clever-tools": "^4.8.0",
    "drizzle-kit": "^1.0.0-beta.22-41a7d21",
    "esbuild": "^0.28.0",
    "eslint": "^10.2.0",
    "happy-dom": "^20.8.9",
    "npm-run-all2": "^8.0.4",
    "storybook": "^10.3.5",
    "tailwind-scrollbar": "^4.0.2",
    "tailwindcss": "^4.2.2",
    "tsx": "^4.21.0",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.58.1",
    "vite": "^8.0.8",
    "vite-plugin-devtools-json": "^1.0.0",
    "vitest": "^4.1.4"
  },
  "overrides": {
    "vite-plugin-devtools-json": {
      "vite": "$vite"
    }
  }
}
