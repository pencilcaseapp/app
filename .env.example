# Lettermint API Token
EMAIL_API_TOKEN=api-token

# Creem (defaults in app/config/dev.ts point at the shared test store;
# override to talk to another store or the live environment)
CREEM_API_URL=https://test-api.creem.io
CREEM_API_KEY=creem_test_api-key
CREEM_PRODUCT_ID=prod_id
CREEM_WEBHOOK_SECRET=whsec_secret
